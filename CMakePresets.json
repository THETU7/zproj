{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "g++-15 / nvcc host, native GPU arch, Release",
      "description": "Uses g++-15 as both the host C++ compiler and the nvcc host compiler, and lets CMake auto-detect the local GPU compute capability.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc-15",
        "CMAKE_CXX_COMPILER": "g++-15",
        "CMAKE_CUDA_COMPILER": "nvcc",
        "CMAKE_CUDA_HOST_COMPILER": "g++-15",
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "CMAKE_CUDA_FLAGS": "--expt-relaxed-constexpr",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "debug", "configurePreset": "debug" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true }
    }
  ]
}
